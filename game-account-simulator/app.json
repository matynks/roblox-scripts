{
  "expo": {
    "name": "Blockora",
    "slug": "blockora",
    "version": "1.0.0",
    "description": "Blockora — an independent game-account simulator. Not affiliated with Roblox Corporation. Orbs are simulated currency with no monetary value.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "blockora",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#070A14",
    "android": {
      "package": "com.blockora.simulator",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0F1F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.SYSTEM_ALERT_WINDOW"]
    },
    "ios": { "bundleIdentifier": "com.blockora.simulator" },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070A14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}

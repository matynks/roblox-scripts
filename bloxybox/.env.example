# BloxyBox environment template.
# Copy to .env (git-ignored) and fill in your Supabase project's values:
#   Supabase dashboard -> Project Settings -> API
#
# Both values are PUBLIC by design (they ship inside the APK). Data is protected
# by Row Level Security and server-side functions, not by hiding these keys.
# NEVER put the service_role key, database password or any other secret here.
#
# If you leave these empty, the app shows a "Server setup" screen on first
# launch where the URL and anon key can be entered instead.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
